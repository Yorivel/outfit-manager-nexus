// Version stamp of OutfitManager.asi (Properties > Details in Explorer; the plugin writes it at the top of its log).
// Keep in step with the browser mod's manifest.json "version".
#include <winver.h>

#define OM_VERSION 0, 5, 0, 1
#define OM_VERSION_STR "0.5.0-dev1"

VS_VERSION_INFO VERSIONINFO
FILEVERSION OM_VERSION
PRODUCTVERSION OM_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Strahlimeier"
            VALUE "FileDescription", "Outfit Manager for Crimson Desert"
            VALUE "FileVersion", OM_VERSION_STR
            VALUE "InternalName", "OutfitManager"
            VALUE "LegalCopyright", "Copyright (c) 2026 Strahlimeier. MIT licence."
            VALUE "OriginalFilename", "OutfitManager.asi"
            VALUE "ProductName", "Outfit Manager"
            VALUE "ProductVersion", OM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
